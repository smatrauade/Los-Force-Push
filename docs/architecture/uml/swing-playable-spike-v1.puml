@startuml
title Swing runtime individual R7 - AS_IMPLEMENTED
package "core" {
  class RuntimeState <<immutable>>
  class LevelProgression
  class RuntimeMoveResult
  enum Direction
}
package "desktop" {
  class SwingApplication
  class "SwingApplication.GameWindow" as GameWindow
  interface GameView
  class GameController
  class GamePresentation <<immutable record>>
  class BoardPanel
  class ArrowBindings
  class PixelAssets
  class SoundManager
  class UiCommands <<record>>
  class LevelResult <<record>>
}
SwingApplication ..> GameWindow : creates on EDT
GameWindow ..|> GameView
GameWindow *-- GameController
GameWindow *-- BoardPanel
GameWindow *-- SoundManager
GameWindow ..> ArrowBindings
GameController --> GameView
GameController --> LevelProgression : owns
GameController ..> RuntimeMoveResult : events
GameController ..> GamePresentation : publishes
GameController ..> LevelResult : adapts core result
GamePresentation --> RuntimeState : immutable
BoardPanel --> RuntimeState : renders
BoardPanel --> PixelAssets
GameView ..> UiCommands
GameView ..> LevelResult
ArrowBindings ..> Direction
note bottom of GameController
No game rules or score calculations in desktop.
Load and advance use explicit catalog formats.
end note
note bottom of GameWindow
MENU / GAME / PAUSE / OPTIONS / HELP / FINISH.
Undo/Restart callbacks follow session availability.
Save/load remain disabled; Observer is not implemented.
end note
package "R8 presentation collaborations" {
  interface VisualThemeFactory <<AbstractFactory>>
  class UiPalette <<product>>
  interface SpritePresentation <<product>>
  class VisualThemes <<registry>>
  class CopperTheme <<concrete factory>>
  class NightTheme <<concrete factory>>
  class JadeTheme <<concrete factory>>
  class MoveCommand <<Command>>
  class ReplayTrace <<immutable>>
  class ReplayRecorder
  class ReplayPlayer <<Invoker>>
  class LockChangeSubject <<Subject>>
  interface LockChangeObserver <<Observer>>
  class GatePresentationObserver
  class LockSoundObserver
}
CopperTheme ..|> VisualThemeFactory
NightTheme ..|> VisualThemeFactory
JadeTheme ..|> VisualThemeFactory
VisualThemes ..> CopperTheme
VisualThemes ..> NightTheme
VisualThemes ..> JadeTheme
VisualThemeFactory ..> UiPalette
VisualThemeFactory ..> SpritePresentation
GameWindow ..> VisualThemeFactory
GameController --> ReplayRecorder
GameController --> LockChangeSubject
GameWindow --> ReplayPlayer
ReplayPlayer --> ReplayTrace
ReplayTrace --> "0..*" MoveCommand
ReplayPlayer ..> MoveCommand : executes
LockChangeSubject o-- "0..*" LockChangeObserver
LockChangeObserver <|.. GatePresentationObserver
LockChangeObserver <|.. LockSoundObserver
GatePresentationObserver --> GameView
LockSoundObserver --> GameView
note bottom of LockChangeSubject
Confirmed transitions only; subject is window-scoped.
Observers do not own or mutate wall state.
end note
@enduml
