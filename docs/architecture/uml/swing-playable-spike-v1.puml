@startuml
title Swing runtime individual R7 - AS_IMPLEMENTED
package "core" {
  class RuntimeState <<immutable>>
  class LevelProgression
  class RuntimeMoveResult
  enum Direction
}
package "desktop" {
  class SwingApplication
  class "SwingApplication.GameWindow" as GameWindow
  interface GameView
  class GameController
  class GamePresentation <<immutable record>>
  class BoardPanel
  class ArrowBindings
  class PixelAssets
  class SoundManager
  class UiCommands <<record>>
  class LevelResult <<record>>
}
SwingApplication ..> GameWindow : creates on EDT
GameWindow ..|> GameView
GameWindow *-- GameController
GameWindow *-- BoardPanel
GameWindow *-- SoundManager
GameWindow ..> ArrowBindings
GameController --> GameView
GameController --> LevelProgression : owns
GameController ..> RuntimeMoveResult : events
GameController ..> GamePresentation : publishes
GameController ..> LevelResult : adapts core result
GamePresentation --> RuntimeState : immutable
BoardPanel --> RuntimeState : renders
BoardPanel --> PixelAssets
GameView ..> UiCommands
GameView ..> LevelResult
ArrowBindings ..> Direction
note bottom of GameController
No game rules or score calculations in desktop.
Load and advance use explicit catalog formats.
end note
note bottom of GameWindow
MENU / GAME / PAUSE / OPTIONS / HELP / FINISH.
Undo/Restart callbacks follow session availability.
Save/load remain disabled; Observer is not implemented.
end note
@enduml
