@startuml
title Loading / C2-L7 / definicion Fragile — experimental, revision 2026-10-29
hide empty members
package ar.edu.uade.sokoban.level {
  class Position <<record>> {
    -row : int
    -column : int
    +row() : int
    +column() : int
  }
  enum Terrain {
    WALL
    FLOOR
    GOAL
  }
  enum Occupant {
    EMPTY
    PLAYER
    BOX
  }
  class Cell <<record>> {
    -terrain : Terrain
    -occupant : Occupant
    +terrain() : Terrain
    +occupant() : Occupant
  }
  class Board <<record>> {
    {static} +MAX_DIMENSION : int = 100
    -rows : List<List<Cell>>
    +rows() : List<List<Cell>>
    +width() : int
    +height() : int
    +cellAt(position : Position) : Cell
    +playerPosition() : Position
    +boxCount() : long
    +goalCount() : long
  }
  class Level <<record>> {
    -board : Board
    +board() : Board
  }
  class LevelBuilder <<internal>> {
    -rows : List<List<Cell>>
    -published : boolean
    ~addRow(row : List<Cell>) : void
    ~build() : Level
  }
  class LevelParser {
    +parse(text : String) : Level
  }
  class C2LevelParser <<internal stateless>> {
    {static} ~parse(text : String) : Level
  }
  class LevelLoader {
    {static} +MAX_FILE_BYTES : int = 65536
    -parser : LevelParser
    +LevelLoader(parser : LevelParser)
    +load(path : Path) : Level
    +loadExperimentalFragile(path : Path) : ExperimentalFragileLevel
    -readText(path : Path) : String
  }
  class ExperimentalFragileParser {
    {static} +MAX_TEXT_CHARS : int = 65536
    +parse(text : String) : ExperimentalFragileLevel
  }
  class ExperimentalFragileLevel <<record>> {
    -spatialTemplate : Board
    -fragileBoxes : List<FragileBox>
    +spatialTemplate() : Board
    +fragileBoxes() : List<FragileBox>
  }
  class "ExperimentalFragileLevel.FragileBox" as FragileBox <<record>> {
    -id : String
    -position : Position
    -initialResistance : int
    +id() : String
    +position() : Position
    +initialResistance() : int
  }
  class LevelFormatException
}
