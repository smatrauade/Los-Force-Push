root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
indent_size = 2

# Floor spaces in external level maps are significant, including at line ends.
[**/levels/**.txt]
trim_trailing_whitespace = false
